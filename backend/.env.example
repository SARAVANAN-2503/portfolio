# Backend environment

# HTTP port
PORT=4000

# Node environment: development | production | test
NODE_ENV=development

# Logging level: trace | debug | info | warn | error
LOG_LEVEL=info

# SQLite database file. Use ':memory:' for tests.
# On Render, mount a persistent disk at /data and set this to /data/portfolio.db
DATABASE_PATH=./data/portfolio.db

# Secret used to sign JWTs. REQUIRED in production.
# Generate with: openssl rand -base64 48h
JWT_SECRET=dev-insecure-change-me-please

# JWT lifetime (e.g. 15m, 1h, 7d)
JWT_EXPIRES_IN=15m

# CORS allowlist (comma-separated exact origins — not wildcards)
CORS_ORIGIN=http://localhost:3000,http://localhost:3001

# HMAC secret used to verify incoming webhooks (Step 3)
WEBHOOK_SECRET=dev-webhook-secret

# Rate limit: capacity per bucket and refill window (ms)
RATE_LIMIT_TOKENS=30
RATE_LIMIT_REFILL_MS=10000
